# Copy to .env and fill in your values

# DuckDB
DB_PATH=data/market.duckdb

# Fundamentals — SEC EDGAR (free, no key; SEC requires a descriptive UA with contact)
SEC_USER_AGENT=algo_trading research your.email@example.com

# Interactive Brokers TWS / IB Gateway
# Point IB_PORT at the Gateway logged into the MAGIC FORMULA paper account (its own
# instance/port — keep it separate from the contract strategy's Gateway).
IB_HOST=127.0.0.1
IB_PORT=7497          # 7497 = TWS paper, 7496 = TWS live, 4002 = Gateway paper, 4001 = Gateway live
IB_CLIENT_ID=5        # distinct from contract strategy (3) and forex (1)
IB_TIMEOUT=20         # seconds to wait for connection

# Daily email report (Gmail: use an App Password, not your login password)
EMAIL_USER=your.email@gmail.com
EMAIL_PASS=your_gmail_app_password
TO_EMAIL=where.to.send@example.com

# Tickers (comma-separated)
TICKERS=AAPL,MSFT,NVDA,TSLA,SPY

# Historical fetch window
HISTORICAL_PERIOD=2y   # yfinance period string: 1d, 5d, 1mo, 3mo, 6mo, 1y, 2y, 5y, 10y, ytd, max
HISTORICAL_INTERVAL=1d # yfinance interval: 1m,2m,5m,15m,30m,60m,90m,1h,1d,5d,1wk,1mo,3mo
